@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&family=Playfair+Display:ital,wght@0,500;0,600;1,500&display=swap');

:root {
  --brown: #392e25;
  --gold: #b69a60;
  --cream: #f7f2eb;
  --ink: #251f1a;
  --line: #e9e1d5;
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  color: var(--ink);
  font-family: 'DM Sans', sans-serif;
}

a {
  color: inherit;
  text-decoration: none;
}

button, input, select {
  font: inherit;
}

button {
  cursor: pointer;
  border: 1px solid var(--line);
  padding: 10px;
  background: white;
}

img {
  max-width: 100%;
  display: block;
}

[hidden] {
  display: none !important;
}

.barra-topo {
  background: var(--brown);
  color: white;
  text-align: center;
  padding: 10px;
  font-size: 10px;
  letter-spacing: 2px;
}

header {
  max-width: 1250px;
  margin: auto;
  padding: 22px 5%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.logo {
  display: flex;
  gap: 10px;
  align-items: center;
  font-weight: bold;
  letter-spacing: 2px;
}

.logo small {
  display: block;
  color: var(--gold);
  font-size: 9px;
  text-align: center;
  margin-top: 4px;
}

#formBusca {
  display: flex;
  flex: 1;
  max-width: 430px;
  border-bottom: 1px solid #ccc;
}

#campoBusca {
  width: 100%;
  padding: 12px;
  border: 0;
}

nav {
  display: flex;
  justify-content: center;
  gap: 25px;
  padding: 15px;
  flex-wrap: wrap;
  border-block: 1px solid var(--line);
  font-size: 12px;
}

nav a:hover {
  color: var(--gold);
}

.hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  background: var(--cream);
  align-items: center;
  min-height: 400px;
}

.hero > div {
  padding: 55px 10%;
}

.hero img {
  width: 100%;
  height: 100%;
  max-height: 520px;
  object-fit: cover;
}

.etiqueta {
  font-size: 10px;
  font-weight: bold;
  letter-spacing: 2px;
  color: #9b7e45;
}

.hero h1 {
  font: 500 clamp(40px, 5vw, 68px)/1.08 'Playfair Display', serif;
}

.hero em,
.sobre em {
  color: var(--gold);
}

.botao {
  display: inline-block;
  background: var(--gold);
  color: white;
  border: 0;
  padding: 14px 20px;
  margin: 10px 0;
}

.beneficios {
  display: flex;
  justify-content: space-around;
  gap: 20px;
  padding: 25px;
  border-bottom: 1px solid var(--line);
  font-size: 12px;
}

main {
  max-width: 1300px;
  margin: auto;
  padding: 65px 5%;
}

h2 {
  font: 500 38px 'Playfair Display', serif;
}

#filtros {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
  align-items: center;
  margin: 25px 0;
}

#filtros button.ativo,
#filtros button:hover {
  background: var(--brown);
  color: white;
}

#filtros label {
  margin-left: auto;
  font-size: 12px;
}

#gradeProdutos {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 28px 18px;
}

.produto-foto {
  position: relative;
  aspect-ratio: 4 / 4.7;
  background: var(--cream);
  overflow: hidden;
}

.produto-foto img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.etiqueta-produto {
  position: absolute;
  top: 10px;
  left: 10px;
  background: white;
  padding: 6px;
  font-size: 9px;
}

.adicionar {
  position: absolute;
  right: 10px;
  bottom: 10px;
  border-radius: 50%;
  font-size: 20px;
}

.produto-info {
  padding: 12px 2px;
}

.produto-info h3 {
  font-size: 13px;
}

.produto-info p,
.produto-categoria {
  font-size: 11px;
  color: #776e64;
}

.preco {
  font-size: 13px;
}

.sobre,
.contato {
  padding: 55px 8%;
  background: var(--cream);
}

.contato {
  text-align: center;
}

footer {
  text-align: center;
  background: #211b16;
  color: white;
  padding: 35px;
}

#fundoModal {
  position: fixed;
  inset: 0;
  z-index: 5;
  background: #0008;
  display: flex;
  justify-content: flex-end;
}

.painel {
  background: white;
  width: min(450px, 100%);
  height: 100%;
  padding: 24px;
  overflow: auto;
}

.topo {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-sacola {
  display: grid;
  grid-template-columns: 75px 1fr;
  gap: 12px;
  padding: 14px 0;
  border-bottom: 1px solid var(--line);
}

.item-sacola img {
  width: 75px;
  height: 85px;
  object-fit: cover;
}

.controles-qtd {
  display: flex;
  align-items: center;
  gap: 10px;
}

.remover-item {
  color: #9a463d;
}

.painel > small {
  display: block;
  margin-bottom: 15px;
}

.painel .botao {
  width: 100%;
}

@media (max-width: 800px) {
  #gradeProdutos {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero > div {
    padding: 35px 7%;
  }
}

@media (max-width: 560px) {
  header {
    flex-wrap: wrap;
  }

  #formBusca {
    order: 3;
    flex-basis: 100%;
  }

  nav {
    justify-content: flex-start;
    flex-wrap: nowrap;
    overflow: auto;
    white-space: nowrap;
  }

  .hero {
    grid-template-columns: 1fr;
  }

  .hero img {
    height: 280px;
  }

  .beneficios {
    flex-direction: column;
  }

  #gradeProdutos {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  main {
    padding: 45px 5%;
  }

  h2 {
    font-size: 30px;
  }
}
